{
  "name": "yapapa",
  "version": "0.1.0",
  "type": "module",
  "description": "Yapapa an HTML-first full-stack framework for building fast, server-rendered web applications with minimal client-side JavaScript",
  "keywords": [
    "framework",
    "web",
    "fullstack",
    "html",
    "htmx",
    "alpine",
    "typescript"
  ],
  "bin": {
    "yapapa": "src/cli/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hxrshdeepsingh/Yapapa.git"
  },
  "homepage": "https://github.com/hxrshdeepsingh/yapapa",
  "bugs": {
    "url": "https://github.com/hxrshdeepsingh/Yapapa/issues"
  },
  "dependencies": {
    "alpinejs": "^3.17.0",
    "htmx.org": "^2.0.10",
    "path-to-regexp": "^8.4.2",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2",
    "tsx": "^4.23.13"
  },
  "engines": {
    "node": ">=20"
  }
}